HOST=0.0.0.0
PORT=10000
NODE_ENV=production

# Optional: the public backend health URL to ping every five minutes while running.
KEEPALIVE_URL=https://your-backend.onrender.com/users

# Set this to the deployed Vercel URL, without a trailing slash.
FRONTEND_URLS=https://your-frontend.vercel.app

# Render/Aiven or another MySQL-compatible database
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=your-database-name

# Generate a long random value. Do not reuse the local value.
JWT_SECRET=replace-with-a-long-random-secret

# Seed account used by startup. Set these in Render environment variables.
SEED_ACCOUNT_NAME=HRMS Admin
SEED_ACCOUNT_EMAIL=admin@example.com
SEED_ACCOUNT_PASSWORD=replace-with-a-strong-password
SEED_COMPANY_NAME=Example Company

# Optional super-admin login.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash# Database Configuration
DB_HOST=localhost
DB_PORT= 3306
DB_USER=root
DB_PASS=Sahil@123
DB_NAME=hrsystem

# Server Configuration
HOST=0.0.0.0
PORT=5000
NODE_ENV=development
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.48:5173
TRUST_PROXY=false
# Set TRUST_PROXY=true when deployed behind a reverse proxy (Nginx, AWS Load Balancer)

# JWT Configuration
JWT_SECRET=your_super_secret_key_here

# Email Configuration
# For Gmail, use an app password. Do not use your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SUPER_ADMIN_EMAIL=superadmi@gmail.com
SUPER_ADMIN_PASSWORD_HASH=$2b$10$apjDGyvnrGqL5/iYs.j8uuyHcvkwfPhpTA1HtY2PrXLLlICJHSG4.
